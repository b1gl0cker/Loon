#!name=Spotify解锁去广告
#!desc=2025.06.27 部分解锁premium,音质不能设置为超高(建议登录后再打开脚本,重启app等待脚本生效)
#!openUrl=https://github.com/app2smile/rules
# 功能: 1.去除播放广告 2.歌手/专辑列表正常展示 3.去除随机播放
#!icon = https://raw.githubusercontent.com/Orz-3/mini/refs/heads/master/Color/Spotify.png

[Rule]
AND,((OR,((DOMAIN-SUFFIX,spotify.com),(DOMAIN-SUFFIX,spotifycdn.com),(DOMAIN-SUFFIX,scdn.co),(DOMAIN-SUFFIX,spotify.com.edgesuite.net))),(PROTOCOL,QUIC)),REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/pendragon\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$/i then request.header.del("if-none-match")

[Mitm]
hostname =spclient.wg.spotify.com, *spclient.spotify.com

[Script]
request if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\//i then script("https://raw.githubusercontent.com/b1gl0cker/Profiles/refs/heads/maѕter/spotify-json.js") with tag="spotifyJson", timeout=10
response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$/i then script("https://raw.githubusercontent.com/b1gl0cker/Profiles/refs/heads/maѕter/spotify-proto.js") with tag="spotifyProto", timeout=10, requires_body=true, binary_body_mode=true