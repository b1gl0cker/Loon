#!name=Google Rewrite
#!desc=Safari 谷歌搜索重定向
#!icon= https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google_Search.png
#!system=ios

[Rewrite]
request if ${url} ~= /^https?:\/\/(www.)?(g|google)\.cn/i then redirect(302, "https://www.google.com")
request if ${url} ~= /^https:\/\/www\.google\.co\.jp/i then redirect(302, "https://www.google.com")

[MITM]
hostname = *.google.com.hk ,*.g.cn,*.google.cn ,*.google.co.jp
